---
import Base from '../../layouts/Base.astro';
import farms from '../../data/farms.json';
export function getStaticPaths() {
  return farms.map(f => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const editionLabel = f.editions === 'both' ? 'Java + Bedrock' : 'Different design per edition';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'HowTo',
    name: `How to build a ${f.name} in Minecraft`,
    description: f.quickAnswer,
    step: f.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s }))
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://minepedia.app/' },
      { '@type': 'ListItem', position: 2, name: 'Farms', item: 'https://minepedia.app/farms/' },
      { '@type': 'ListItem', position: 3, name: f.name, item: `https://minepedia.app/farms/${f.slug}/` }
    ]
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: `How do you build a ${f.name.toLowerCase()} in Minecraft?`,
        acceptedAnswer: { '@type': 'Answer', text: f.quickAnswer } },
      { '@type': 'Question', name: `Does this ${f.name.toLowerCase()} work on Bedrock?`,
        acceptedAnswer: { '@type': 'Answer', text: f.editions === 'both' ? 'Yes, the same design works in Java and Bedrock Edition.' : 'Java and Bedrock need different designs for this farm - see the mechanics section for the per-edition details.' } }
    ]
  }
];
---
<Base title={`${f.name} (How to Build)`} description={`Minecraft ${f.name.toLowerCase()}: ${f.quickAnswer.slice(0, 150)} Materials, steps, rates and Java/Bedrock notes.`} canonicalPath={`/farms/${f.slug}/`} jsonLd={jsonLd} ogType="article">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / <a href="/farms/">Farms</a> / {f.name}</nav>
    <h1>{f.name}</h1>
    <p><span class="badge">{f.difficulty}</span> <span class="badge">{editionLabel}</span></p>
    <p><strong>Produces:</strong> {f.produces}</p>
    <div class="quick-answer"><strong>Quick answer:</strong> {f.quickAnswer}</div>
    <h2>How it works</h2>
    <ul>{f.mechanics.map(m => <li>{m}</li>)}</ul>
    <h2>Materials</h2>
    <ul>{f.materials.map(m => <li>{m}</li>)}</ul>
    <h2>Build steps</h2>
    <ol>{f.steps.map(s => <li>{s}</li>)}</ol>
    <h2>Rates</h2>
    <p>{f.rates}</p>
    <h2>Tips</h2>
    <ul>{f.tips.map(t => <li>{t}</li>)}</ul>
    <p><a href="/farms/">&larr; All farms</a></p>
  </div>
</Base>
