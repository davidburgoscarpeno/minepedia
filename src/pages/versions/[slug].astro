---
import Base from '../../layouts/Base.astro';
import versions from '../../data/versions.json';
export function getStaticPaths() {
  return versions.map(v => ({ params: { slug: v.slug }, props: { v } }));
}
const { v } = Astro.props;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: `Minecraft ${v.name}: Everything New`,
    description: `Minecraft ${v.name} (${v.date}): all new features and why they matter.`,
    mainEntityOfPage: `https://minepedia.app/versions/${v.slug}/`,
    author: { '@type': 'Organization', name: 'Minepedia' }
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://minepedia.app/' },
      { '@type': 'ListItem', position: 2, name: 'Versions', item: 'https://minepedia.app/versions/' },
      { '@type': 'ListItem', position: 3, name: v.name, item: `https://minepedia.app/versions/${v.slug}/` }
    ]
  }
];
---
<Base title={`${v.name} (What's New)`} description={`Minecraft ${v.name}: every new feature, released ${v.date}. Highlights and what changed for survival.`} canonicalPath={`/versions/${v.slug}/`} jsonLd={jsonLd} ogType="article">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / <a href="/versions/">Versions</a> / {v.name}</nav>
    <h1>{v.name}</h1>
    <p><span class="badge">{v.date}</span></p>
    <h2>Everything new</h2>
    <ul>{v.highlights.map(h => <li>{h}</li>)}</ul>
    <h2>Why it matters</h2>
    <ul>{v.whyItMatters.map(w => <li>{w}</li>)}</ul>
    <p><a href="/versions/">&larr; All versions</a></p>
  </div>
</Base>
