---
import Base from '../../../layouts/Base.astro';
const mods = [
  { name: 'Create', loader: 'NeoForge (Fabric port exists)', what: 'Rotational power, cogs, belts, trains and automated contraptions that look like they belong in vanilla. The most beloved tech mod ever made - builds are machines, not magic boxes.' },
  { name: 'Botania', loader: 'NeoForge', what: 'Tech disguised as magic: generate mana with flowers, automate it with redstone-free logic. Beautiful, self-balancing and endlessly creative.' },
  { name: 'Twilight Forest', loader: 'NeoForge', what: 'A whole new dimension with dungeons, bosses and loot progression. The classic adventure mod - feels like an official expansion.' },
  { name: 'Applied Energistics 2', loader: 'NeoForge', what: 'Digital storage and auto-crafting networks. When your chest room needs a database, this is it.' },
  { name: 'Mekanism', loader: 'NeoForge', what: 'Full industrial tech: ore processing up to 5x, factories, fusion reactors. Deep but well-documented in-game.' },
  { name: 'Farmer\'s Delight', loader: 'NeoForge / Fabric', what: 'Cooking and farming expansion with stoves, cutting boards and dozens of dishes that fit vanilla perfectly. The cozy mod.' },
  { name: 'Alex\'s Mobs', loader: 'NeoForge', what: 'Around 90 new animals and creatures with real behaviors and drops. The best mob mod for vanilla-style play.' },
  { name: 'Terralith', loader: 'Fabric / NeoForge (also a datapack)', what: 'Nearly 100 new biomes built from vanilla blocks - worldgen that feels like 1.18 squared. No new blocks, works on servers without clients modded.' },
  { name: 'Supplementaries', loader: 'NeoForge / Fabric', what: 'Dozens of small vanilla-plus blocks and items: ropes, jars, signs, globes. Everything feels like it should have shipped with the game.' },
  { name: 'Waystones', loader: 'NeoForge / Fabric', what: 'Craftable teleport stones for long-distance travel. The quality-of-life answer to mega-bases far apart.' },
  { name: 'Cobblemon', loader: 'Fabric / NeoForge', what: 'Pokemon in Minecraft, open source and vanilla-friendly. Catch, battle and build with creatures that blend into the world.' }
];
---
<Base title="Best Minecraft Content Mods" description="The best Minecraft content mods: Create, Botania, Twilight Forest, Applied Energistics 2, Farmer's Delight, Terralith and more. What each adds and which loader it needs." canonicalPath="/mods/best-content-mods/">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / <a href="/mods/">Mods</a> / Content Mods</nav>
    <h1>Best Content Mods</h1>
    <p class="sub">Hand-picked, free, and actively maintained. Check each mod's page for your game version before installing.</p>
    <div class="quick-answer"><strong>Quick answer:</strong> want machines and automation that fit vanilla? Create. A second game inside the first? Twilight Forest. Better worldgen without new blocks? Terralith. Cozy cooking? Farmer's Delight. More animals? Alex's Mobs.</div>
    {mods.map(m => (
      <div>
        <h2>{m.name} <span class="badge">{m.loader}</span></h2>
        <p>{m.what}</p>
      </div>
    ))}
    <h2>Before you install content mods</h2>
    <ul>
      <li>Back up your world. Content mods add blocks and items to your save - removing the mod later deletes them.</li>
      <li>Match the game version exactly, and prefer one loader ecosystem per instance (NeoForge mods and Fabric mods do not mix).</li>
      <li>For servers: every player usually needs the same content mods installed. Performance mods are client-side and optional per player.</li>
    </ul>
  </div>
</Base>
