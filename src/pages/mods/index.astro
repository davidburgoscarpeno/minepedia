---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import Icon from '../../components/Icon.astro';
const pages = [
  { href: '/mods/install-mods-java/', name: 'How to Install Mods (Java)', desc: 'Fabric vs NeoForge, Modrinth App, the mods folder, version matching' },
  { href: '/mods/essential-mods/', name: 'Essential Performance & QoL Mods', desc: 'Sodium, Lithium, Iris, JEI and the rest of the standard stack' },
  { href: '/mods/best-content-mods/', name: 'Best Content Mods', desc: 'Create, Botania, Twilight Forest, Farmer\'s Delight and more' },
  { href: '/mods/shaders/', name: 'Shaders Guide', desc: 'Iris, Complementary, BSL - and Vibrant Visuals on Bedrock' },
  { href: '/mods/bedrock-addons/', name: 'Bedrock Add-ons', desc: 'What add-ons can and cannot do, and how to stay safe installing them' }
];
---
<Base title="Minecraft Mods" description="Minecraft mods guide: how to install mods with Fabric or NeoForge, the essential performance mods, best content mods, shaders and Bedrock add-ons. Free and safe." canonicalPath="/mods/">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / Mods</nav>
    <h1>Minecraft Mods</h1>
    <p class="sub">Everything is free. No affiliate links, no repost sites - we only point to official sources.</p>
    <SearchBox placeholder="Search mods, guides, tools..." />

    <div class="quick-answer"><strong>Quick answer:</strong> mods are a Java Edition thing. Install the Modrinth App, pick Fabric for performance mods or NeoForge for big content mods, and everything else is one click. On Bedrock (console/mobile) there are no mods - only add-ons, which do far less.</div>

    <div class="grid-cards">
      {pages.map(p => (
        <a class="card" href={p.href}><h3>{p.name}</h3><p>{p.desc}</p></a>
          <div class="icon"><Icon name="puzzle" /></div>
      ))}
    </div>

    <h2>Golden rules of modding</h2>
    <ul>
      <li><strong>Only download from Modrinth or CurseForge</strong> (or the mod's official GitHub/Discord). Sites that repost popular mod names bundle malware - the classic trap is searching a mod name and clicking the first ad.</li>
      <li><strong>Mods are free.</strong> Anyone charging for a Minecraft mod itself is breaking Mojang's rules and probably scamming you.</li>
      <li><strong>Match versions:</strong> a mod built for 1.21 will not work on 26.x and vice versa. Check the mod page's supported versions.</li>
      <li><strong>Back up your world</strong> before adding content mods. Performance mods are safe; worldgen mods change your save forever.</li>
    </ul>
  </div>
</Base>
