---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import recipes from '../../data/recipes.json';
import Icon from '../../components/Icon.astro';
const cats = [...new Set(recipes.map(r => r.category))].sort();
---
<Base title="Minecraft Crafting Recipes" description="Minecraft crafting recipes with ingredients, patterns, how to get each material, uses and Java/Bedrock notes." canonicalPath="/recipes/">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / Crafting Recipes</nav>
    <h1>Minecraft Crafting Recipes</h1>
    <p class="sub">{recipes.length} recipes with exact ingredients, patterns and how to get every material.</p>
    <SearchBox placeholder="Search recipes, items, commands..." />
    {cats.map(cat => (
      <section class="section">
        <h2>{cat}</h2>
        <div class="grid-cards">
          {recipes.filter(r => r.category === cat).map(r => (
            <a class="card" href={`/recipes/${r.slug}/`}>
              <div class="icon"><Icon name="grid" /></div>
              <h3>{r.name}</h3>
              <p>{r.ingredients.map(i => `${i.qty}x ${i.name}`).join(' + ')}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
