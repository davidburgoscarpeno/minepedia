---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import commands from '../data/commands.json';
import recipes from '../data/recipes.json';
import enchantments from '../data/enchantments.json';
import mobs from '../data/mobs.json';
import guides from '../data/guides.json';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: 'Minepedia', url: 'https://minepedia.app/',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://minepedia.app/search/?q={search_term_string}' },
    'query-input': 'required name=search_term_string'
  }
};
const cats = [
  { href: '/guides/', name: 'Guides', desc: 'How to craft, find, tame, build and more' },
  { href: '/recipes/', name: 'Crafting Recipes', desc: 'Every recipe with ingredients and uses' },
  { href: '/commands/', name: 'Commands', desc: 'Syntax and examples for every command' },
  { href: '/enchantments/', name: 'Enchantments', desc: 'Max levels, uses and incompatibilities' },
  { href: '/mobs/', name: 'Mobs', desc: 'Drops, spawning and behavior' },
  { href: '/tools/', name: 'Tools & Calculators', desc: 'Nether coords, XP, command generators' },
  { href: '/villagers/', name: 'Villager Trades', desc: 'All professions, workstations and trade tables' },
  { href: '/items/', name: 'Items', desc: 'How to get and farm key items' },
  { href: '/farms/', name: 'Farms', desc: 'Iron, XP, gold and raid farms step by step' },
  { href: '/biomes/', name: 'Biomes', desc: 'Resources, mobs and structures per biome' },
  { href: '/structures/', name: 'Structures', desc: 'Villages, strongholds, bastions and more' },
  { href: '/seeds/', name: 'Seeds', desc: 'How seeds work + famous verified seeds' }
];
---
<Base title="Minepedia" description="Minepedia: Minecraft guides, crafting recipes, commands, enchantments, mobs, seeds and tools - fast, accurate and always up to date." canonicalPath="/" jsonLd={jsonLd}>
  <div class="container">
    <section class="hero">
      <h1>The Minecraft knowledge base</h1>
      <p>Guides, recipes, commands, enchantments, mobs and tools. Accurate for Java and Bedrock.</p>
      <SearchBox autofocus={true} />
    </section>
    <section class="section">
      <h2>Categories</h2>
      <div class="grid-cards">
        {cats.map(cat => (
          <a class="card" href={cat.href}><h3>{cat.name}</h3><p>{cat.desc}</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Latest guides</h2>
      <p class="sub">Step-by-step answers to the most searched questions.</p>
      <div class="grid-cards">
        {guides.slice(0, 6).map(g => (
          <a class="card" href={`/guides/${g.slug}/`}><h3>{g.name}</h3><p>{g.quickAnswer.split('.')[0]}.</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Latest crafting recipes</h2>
      <p class="sub">Step-by-step recipes with materials and uses.</p>
      <div class="grid-cards">
        {recipes.slice(0, 6).map(r => (
          <a class="card" href={`/recipes/${r.slug}/`}><h3>{r.name}</h3><p>{r.ingredients.map(i => `${i.qty}x ${i.name}`).join(' + ')}</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Enchantments</h2>
      <p class="sub">What they do and how to get them.</p>
      <div class="grid-cards">
        {enchantments.slice(0, 6).map(e => (
          <a class="card" href={`/enchantments/${e.slug}/`}><h3>{e.name}</h3><p>Max level {e.maxLevel}</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Mob database</h2>
      <p class="sub">Drops, spawning and strategies.</p>
      <div class="grid-cards">
        {mobs.slice(0, 6).map(m => (
          <a class="card" href={`/mobs/${m.slug}/`}><h3>{m.name}</h3><p>{m.type}</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Popular commands</h2>
      <p class="sub">The commands players search for most.</p>
      <div class="grid-cards">
        {commands.slice(0, 6).map(c => (
          <a class="card" href={`/commands/${c.slug}/`}><h3>{c.name}</h3><p>{c.summary}</p></a>
        ))}
      </div>
    </section>
  </div>
</Base>
