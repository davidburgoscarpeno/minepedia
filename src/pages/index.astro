---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import commands from '../data/commands.json';
import recipes from '../data/recipes.json';
import enchantments from '../data/enchantments.json';
import mobs from '../data/mobs.json';
import guides from '../data/guides.json';
import GameShot from '../components/GameShot.astro';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: 'Minepedia', url: 'https://minepedia.app/',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://minepedia.app/search/?q={search_term_string}' },
    'query-input': 'required name=search_term_string'
  }
};
const I = {
  book: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19a2 2 0 0 0 2 2h13"/><path d="M9 7h6"/></svg>',
  grid: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>',
  term: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m6 9 3 3-3 3M12 15h6"/></svg>',
  star: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>',
  flask: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v5l-5 9a3 3 0 0 0 2.6 4.5h8.8A3 3 0 0 0 19 17l-5-9V3"/><path d="M7.5 14h9"/></svg>',
  sword: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4.5 20 3l-1.5 5.5L9 18l-4.5-4.5z"/><path d="m7 14-4 7M5 16l3 3"/></svg>',
  wrench: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4.5 4.5 0 0 0-6 5.6L3 17.6V21h3.4l5.7-5.7a4.5 4.5 0 0 0 5.6-6L14 13l-3-3z"/></svg>',
  gem: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M2 9h20M9 3l3 6 3-6M12 9v12"/></svg>',
  cube: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="M3 7l9 5 9-5M12 12v10"/></svg>',
  wheat: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V8"/><path d="M12 8C12 5 10 3 7 3c0 3 2 5 5 5zM12 8c0-3 2-5 5-5 0 3-2 5-5 5zM12 14c0-3-2-5-5-5 0 3 2 5 5 5zM12 14c0-3 2-5 5-5 0 3-2 5-5 5z"/></svg>',
  mountain: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 20 6-11 4 6 2-3 6 8z"/><circle cx="17" cy="5" r="2"/></svg>',
  tower: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V8l3-2V4h2v2h4V4h2v2l3 2v13"/><path d="M3 21h18M10 21v-4h4v4"/></svg>',
  sprout: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-7"/><path d="M12 15C12 10 9 7 4 7c0 5 3 8 8 8zM12 13c0-4 2.5-6 7-6 0 4-2.5 6-7 6z"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>',
  puzzle: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M9 3h6v4a2 2 0 1 0 0 4h4v6h-4a2 2 0 1 1 0 4H9v-4a2 2 0 1 0 0-4H5V7h4z" transform="scale(0.9) translate(1.3,1.3)"/></svg>',
  server: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>'
};
const cats = [
  { href: '/guides/', name: 'Guides', desc: 'How to craft, find, tame, build and more', icon: 'book', count: '16' },
  { href: '/recipes/', name: 'Crafting Recipes', desc: 'Every recipe with visual grids and ingredients', icon: 'grid', count: '40' },
  { href: '/commands/', name: 'Commands', desc: 'Syntax and examples for every command', icon: 'term', count: '30' },
  { href: '/enchantments/', name: 'Enchantments', desc: 'Max levels, uses and incompatibilities', icon: 'star', count: '20' },
  { href: '/potions/', name: 'Potions', desc: 'Every brewing recipe and effect', icon: 'flask', count: '19' },
  { href: '/mobs/', name: 'Mobs', desc: 'Drops, spawning and behavior', icon: 'sword', count: '41' },
  { href: '/tools/', name: 'Tools & Calculators', desc: 'Nether coords, XP, command generators', icon: 'wrench', count: '3' },
  { href: '/villagers/', name: 'Villager Trades', desc: 'All professions, workstations and trade tables', icon: 'gem', count: '13' },
  { href: '/items/', name: 'Items', desc: 'How to get and farm key items', icon: 'cube', count: '20' },
  { href: '/farms/', name: 'Farms', desc: 'Iron, XP, gold and raid farms step by step', icon: 'wheat', count: '9' },
  { href: '/biomes/', name: 'Biomes', desc: 'Resources, mobs and structures per biome', icon: 'mountain', count: '22' },
  { href: '/structures/', name: 'Structures', desc: 'Villages, strongholds, bastions and more', icon: 'tower', count: '12' },
  { href: '/seeds/', name: 'Seeds', desc: 'How seeds work + famous verified seeds', icon: 'sprout', count: '3' },
  { href: '/versions/', name: 'Versions', desc: 'What every update added, 1.20 to 26.3', icon: 'clock', count: '6' },
  { href: '/mods/', name: 'Mods', desc: 'Install guides, essential mods and shaders', icon: 'puzzle', count: '5' },
  { href: '/servers/', name: 'Servers', desc: 'Make, host and manage your own server', icon: 'server', count: '4' }
];
---
<Base title="Minepedia" description="Minepedia: Minecraft guides, crafting recipes, commands, enchantments, mobs, seeds and tools - fast, accurate and always up to date." canonicalPath="/" jsonLd={jsonLd}>
  <div class="container">
    <section class="hero">
      <h1>The Minecraft knowledge base</h1>
      <p>Guides, recipes, commands, enchantments, mobs and tools. Accurate for Java and Bedrock.</p>
      <img src="/hero.svg" alt="Pixel-art voxel landscape: blocky mountains, trees and sun" width="1200" height="360" loading="eager" style="width:100%;max-width:760px;height:auto;border-radius:14px;margin:0 auto 22px;display:block" />
      <SearchBox autofocus={true} />
      <GameShot id="home-mountains" />
    </section>
    <section class="section">
      <h2>Categories</h2>
      <div class="grid-cards">
        {cats.map(cat => (
          <a class="card" href={cat.href}>
            <span class="count">{cat.count}</span>
            <div class="icon" set:html={I[cat.icon]} />
            <h3>{cat.name}</h3><p>{cat.desc}</p>
          </a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Latest guides</h2>
      <p class="sub">Step-by-step answers to the most searched questions.</p>
      <div class="grid-cards">
        {guides.slice(0, 6).map(g => (
          <a class="card" href={`/guides/${g.slug}/`}><h3>{g.name}</h3><p>{g.quickAnswer.split('.')[0]}.</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Latest crafting recipes</h2>
      <p class="sub">Step-by-step recipes with materials and uses.</p>
      <div class="grid-cards">
        {recipes.slice(0, 6).map(r => (
          <a class="card" href={`/recipes/${r.slug}/`}><h3>{r.name}</h3><p>{r.ingredients.map(i => `${i.qty}x ${i.name}`).join(' + ')}</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Enchantments</h2>
      <p class="sub">What they do and how to get them.</p>
      <div class="grid-cards">
        {enchantments.slice(0, 6).map(e => (
          <a class="card" href={`/enchantments/${e.slug}/`}><h3>{e.name}</h3><p>Max level {e.maxLevel}</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Mob database</h2>
      <p class="sub">Drops, spawning and strategies.</p>
      <div class="grid-cards">
        {mobs.slice(0, 6).map(m => (
          <a class="card" href={`/mobs/${m.slug}/`}><h3>{m.name}</h3><p>{m.type}</p></a>
        ))}
      </div>
    </section>
    <section class="section">
      <h2>Popular commands</h2>
      <p class="sub">The commands players search for most.</p>
      <div class="grid-cards">
        {commands.slice(0, 6).map(c => (
          <a class="card" href={`/commands/${c.slug}/`}><h3>{c.name}</h3><p>{c.summary}</p></a>
        ))}
      </div>
    </section>
  </div>
</Base>
