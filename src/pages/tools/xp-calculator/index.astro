---
import Base from '../../../layouts/Base.astro';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: 'Minecraft XP Calculator',
    url: 'https://minepedia.app/tools/xp-calculator/',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How much XP does level 30 cost in Minecraft?',
        acceptedAnswer: { '@type': 'Answer', text: 'Reaching level 30 from zero takes 1,395 experience points in total. However, enchanting at level 30 only spends 3 levels, and each enchant after that costs progressively less total XP than refarming from zero - higher levels cost more points per level.' } },
      { '@type': 'Question', name: 'Is the XP formula the same in Java and Bedrock?',
        acceptedAnswer: { '@type': 'Answer', text: 'Yes. Both editions use the same experience curve: levels 0-16 cost 2L+7 points each, levels 17-31 cost 5L-38, and level 32+ costs 9L-158 per level.' } }
    ]
  }
];
---
<Base title="Minecraft XP Calculator" description="Convert Minecraft experience levels to XP points and back. Level 30 enchanting costs, XP per level formula, Java and Bedrock." canonicalPath="/tools/xp-calculator/" jsonLd={jsonLd}>
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / <a href="/tools/">Tools</a> / XP Calculator</nav>
    <h1>Minecraft XP Calculator</h1>
    <p class="sub">Convert between experience levels and raw XP points. Same formula in Java and Bedrock.</p>
    <div class="quick-answer"><strong>Quick answer:</strong> Level 30 needs 1,395 XP total. Enchanting spends only 3 levels, but going from 27 to 30 costs 306 XP while 0 to 3 costs just 32 XP - so enchant as soon as you hit 30.</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin:24px 0">
      <div class="card">
        <h3>Levels to XP</h3>
        <div style="display:flex;gap:8px;margin:12px 0">
          <input id="lvl" type="number" min="0" placeholder="Level (e.g. 30)" class="search-input" style="padding:10px" />
        </div>
        <button class="copy-btn" id="lvl-btn" style="padding:10px 20px">Calculate XP</button>
        <p id="lvl-out" style="font-size:1.1rem;font-weight:700;color:var(--accent-bright)"></p>
      </div>
      <div class="card">
        <h3>XP to levels</h3>
        <div style="display:flex;gap:8px;margin:12px 0">
          <input id="xp" type="number" min="0" placeholder="XP points (e.g. 1395)" class="search-input" style="padding:10px" />
        </div>
        <button class="copy-btn" id="xp-btn" style="padding:10px 20px">Calculate level</button>
        <p id="xp-out" style="font-size:1.1rem;font-weight:700;color:var(--accent-bright)"></p>
      </div>
      <div class="card">
        <h3>Level-up cost</h3>
        <div style="display:flex;gap:8px;margin:12px 0">
          <input id="lvl-from" type="number" min="0" placeholder="From level" class="search-input" style="padding:10px" />
          <input id="lvl-to" type="number" min="0" placeholder="To level" class="search-input" style="padding:10px" />
        </div>
        <button class="copy-btn" id="cost-btn" style="padding:10px 20px">Calculate cost</button>
        <p id="cost-out" style="font-size:1.1rem;font-weight:700;color:var(--accent-bright)"></p>
      </div>
    </div>

    <h2>How Minecraft XP works</h2>
    <p>Every level costs more XP than the last. The game tracks your progress in raw experience points, and the level is derived from them:</p>
    <ul>
      <li><strong>Levels 0-16:</strong> each level costs 2L + 7 points (level 0 to 1 costs 7, level 15 to 16 costs 37).</li>
      <li><strong>Levels 17-31:</strong> each level costs 5L - 38 points.</li>
      <li><strong>Level 32+:</strong> each level costs 9L - 158 points and keeps growing.</li>
    </ul>
    <p>Total XP to reach a level L from zero: L² + 6L (up to 16), 2.5L² - 40.5L + 360 (17-31), and 4.5L² - 162.5L + 2220 (32+). The formula is identical in Java and Bedrock Edition.</p>

    <h2>Why you should enchant at exactly level 30</h2>
    <p>An enchanting table spend is 3 levels, not a fixed amount of XP. Going from level 0 to 3 costs 32 XP, but going from 27 to 30 costs 306 XP - almost ten times more for the same enchant. So always enchant the moment you reach level 30: each subsequent enchant costs far fewer total points. The same logic applies to anvil work: do expensive jobs at lower levels when the level cost is small.</p>

    <h2>Best XP sources</h2>
    <ul>
      <li><strong>Mob farms:</strong> a good general mob farm or enderman farm gives level 30 in minutes.</li>
      <li><strong>Furnace XP banks:</strong> smelted items store XP in the furnace; pull one item out after a big smelting session (works with cactus, cobblestone, kelp).</li>
      <li><strong>Mining:</strong> quartz, coal, redstone, lapis and diamond ore all drop XP - a Fortune pick does not increase XP drops.</li>
      <li><strong>Bottle o' enchanting:</strong> 3-11 XP each; master clerics sell them for 3 emeralds.</li>
      <li><strong>Trading and breeding:</strong> steady low-level XP while doing other work.</li>
    </ul>
  </div>
  <script>
    function xpForLevel(l: number): number {
      if (l <= 16) return l * l + 6 * l;
      if (l <= 31) return Math.floor(2.5 * l * l - 40.5 * l + 360);
      return Math.floor(4.5 * l * l - 162.5 * l + 2220);
    }
    function levelForXp(x: number): { level: number, progress: number, next: number } {
      let l = 0;
      while (xpForLevel(l + 1) <= x) l++;
      const into = x - xpForLevel(l);
      const need = xpForLevel(l + 1) - xpForLevel(l);
      return { level: l, progress: into, next: need };
    }
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    $('lvl-btn')!.addEventListener('click', () => {
      const l = parseInt($('lvl').value);
      if (isNaN(l) || l < 0) { $('lvl-out').textContent = 'Enter a level of 0 or more.'; return; }
      $('lvl-out').textContent = `Level ${l} = ${xpForLevel(l).toLocaleString('en-US')} XP total from level 0`;
    });
    $('xp-btn')!.addEventListener('click', () => {
      const x = parseInt($('xp').value);
      if (isNaN(x) || x < 0) { $('xp-out').textContent = 'Enter 0 or more XP points.'; return; }
      const r = levelForXp(x);
      $('xp-out').textContent = `${x.toLocaleString('en-US')} XP = level ${r.level} + ${r.progress}/${r.next} toward level ${r.level + 1}`;
    });
    $('cost-btn')!.addEventListener('click', () => {
      const a = parseInt($('lvl-from').value), b = parseInt($('lvl-to').value);
      if (isNaN(a) || isNaN(b) || a < 0 || b <= a) { $('cost-out').textContent = 'Enter a start level and a higher target level.'; return; }
      $('cost-out').textContent = `Level ${a} to ${b} costs ${(xpForLevel(b) - xpForLevel(a)).toLocaleString('en-US')} XP`;
    });
  </script>
</Base>
