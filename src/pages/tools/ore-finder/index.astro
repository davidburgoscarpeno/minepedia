---
import Base from '../../../layouts/Base.astro';
import ores from '../../../data/ores.json';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: 'Minecraft Ore Finder',
    url: 'https://minepedia.app/tools/ore-finder/',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is the best Y level for diamonds in Minecraft?',
        acceptedAnswer: { '@type': 'Answer', text: 'Y=-59. Diamond ore generates from Y=16 down to bedrock with peak frequency at the deepest levels, and Y=-59 keeps you just above the bedrock floor. Branch mining beats caving because diamonds generate less often when exposed to air since 1.18.' } },
      { '@type': 'Question', name: 'What is the best Y level for iron in Minecraft?',
        acceptedAnswer: { '@type': 'Answer', text: 'Two peaks: Y=14 underground and Y=232 on mountains. Early game, mine caves and cliffs in mountain biomes - the high-altitude batch around Y=232 is the densest iron in the game.' } }
    ]
  }
];
---
<Base title="Minecraft Ore Finder (Best Y Levels)" description="Best Y level for every Minecraft ore: diamonds at -59, iron at 14 and 232, ancient debris at 16. Full 1.21 ore distribution chart for Java and Bedrock." canonicalPath="/tools/ore-finder/" jsonLd={jsonLd}>
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / <a href="/tools/">Tools</a> / Ore Finder</nav>
    <h1>Ore Finder: Best Y Levels</h1>
    <p class="sub">Where to mine every ore in 1.21, from real world-generation data. Java and Bedrock.</p>
    <div class="quick-answer"><strong>Quick answer:</strong> diamonds and redstone at Y=-59, iron at Y=14 or Y=232 on mountains, gold at Y=-18 (or badlands surface), ancient debris at Y=16 in the Nether.</div>

    <div class="card" style="margin:24px 0">
      <h3>Pick an ore</h3>
      <select id="ore-sel" class="search-input" style="padding:10px;width:100%;max-width:320px">
        <option value="">Choose an ore...</option>
      </select>
      <div id="ore-out" style="margin-top:12px"></div>
    </div>

    <h2>Full distribution chart</h2>
    <table class="data">
      <tr><th>Ore</th><th>Range</th><th>Best Y level</th><th>Notes</th></tr>
      {ores.map(o => (
        <tr><td><strong>{o.name}</strong></td><td>{o.range}</td><td>{o.bestY}</td><td>{o.notes}</td></tr>
      ))}
    </table>

    <h2>Mining tips that matter more than Y level</h2>
    <ul>
      <li><strong>Reduced air exposure (1.18+):</strong> diamonds, lapis and gold generate less often in blocks exposed to air. Branch mining beats cave running for those three.</li>
      <li><strong>Fortune III</strong> multiplies drops from every ore except iron and gold (which drop raw blocks - smelt them or use Silk Touch).</li>
      <li><strong>Deepslate is slower to mine:</strong> below Y=8 most ores come in deepslate variants. Bring Efficiency IV+ or accept the slower swings.</li>
      <li><strong>Bed mining in the Nether:</strong> beds explode in the Nether and cost almost nothing - the classic ancient debris method at Y=15. Bring fire resistance.</li>
    </ul>
    <p>Related guides: <a href="/guides/how-to-find-diamonds/">How to Find Diamonds</a> - <a href="/items/netherite-ingot/">Netherite Ingot</a> - <a href="/guides/how-to-find-ancient-city/">Deep Dark</a></p>
  </div>
  <script define:vars={{ ores }}>
    const sel = document.getElementById('ore-sel');
    const out = document.getElementById('ore-out');
    ores.forEach(o => {
      const opt = document.createElement('option');
      opt.value = o.name; opt.textContent = o.name;
      sel.appendChild(opt);
    });
    sel.addEventListener('change', () => {
      const o = ores.find(x => x.name === sel.value);
      if (!o) { out.innerHTML = ''; return; }
      out.innerHTML = `<p style="font-size:1.1rem"><strong>${o.name}</strong>: mine at <span style="color:var(--accent-bright);font-weight:700">Y=${o.bestY}</span></p><p>Range: ${o.range}. ${o.notes}</p>`;
    });
  </script>
</Base>
