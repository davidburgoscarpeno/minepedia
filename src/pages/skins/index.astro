---
import Base from '../../layouts/Base.astro';
import skins1 from '../../data/gallery-skins.json';
import skins2 from '../../data/gallery-skins-2.json';
const skins = [...skins1, ...skins2];
const cats = [...new Set(skins.map(s => s.category))];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage',
    name: 'Minecraft Skins - Free Original Downloads',
    url: 'https://minepedia.app/skins/',
    description: 'Original Minecraft skins designed by Minepedia: free 64x64 PNG downloads for Java and Bedrock, editable online in the Skin Maker.' },
  { '@context': 'https://schema.org', '@type': 'ItemList',
    itemListElement: skins.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: `${s.name} Minecraft Skin`, url: `https://minepedia.app/skins/${s.slug}/` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Are these Minecraft skins free to download?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Every skin in this gallery is an original Minepedia design, free to download as a standard 64x64 PNG for Java and Bedrock, with no account and no watermark.' } },
      { '@type': 'Question', name: 'How do I apply a downloaded skin?', acceptedAnswer: { '@type': 'Answer', text: 'On Java Edition, open the Minecraft Launcher, go to the Skins tab, and add the PNG file. On Bedrock, file-based skins work through the Dressing Room import where the platform allows it, or inside a custom skin pack.' } },
      { '@type': 'Question', name: 'Can I edit a skin before using it?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Every skin has an Edit in Skin Maker button that opens it in our free browser editor, where you can repaint any pixel and download your own version.' } },
      { '@type': 'Question', name: 'Are these official Minecraft skins?', acceptedAnswer: { '@type': 'Answer', text: 'No. All designs are original fan art drawn by Minepedia. This is not an official Minecraft product and is not approved by or associated with Mojang or Microsoft.' } }
    ] }
];
---
<Base title="Minecraft Skins - Free Original Downloads" description="Download free original Minecraft skins: knight, ninja, astronaut, wizard, pirate and more. 64x64 PNGs for Java and Bedrock, editable online in our Skin Maker." canonicalPath="/skins/" jsonLd={jsonLd}>
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / Skins</nav>
    <h1>Minecraft Skins</h1>
    <p class="sub">{skins.length} original skins designed pixel by pixel by Minepedia. Download the 64x64 PNG ready for your launcher, or open any skin in the <a href="/tools/skin-maker/">Skin Maker</a> and make it yours. New designs added regularly.</p>
    {cats.map(c => (
      <section>
        <h2>{c}</h2>
        <div class="skin-grid">
          {skins.filter(s => s.category === c).map(s => (
            <div class="skin-card">
              <a href={`/skins/${s.slug}/`} class="skin-prev"><canvas class="skinview" data-src={s.file} data-view="front" data-scale="5" width="80" height="160"></canvas></a>
              <h3><a href={`/skins/${s.slug}/`}>{s.name}</a></h3>
              <div class="skin-actions">
                <a class="sbtn primary" href={s.file} download={`minepedia-${s.slug}-skin.png`}>⬇️ PNG</a>
                <a class="sbtn" href={`/tools/skin-maker/?skin=${s.file}`}>🎨 Edit</a>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
    <h2>How to use these skins</h2>
    <ol>
      <li><strong>Download</strong> the PNG of the skin you like (or open it in the Skin Maker and edit it first).</li>
      <li><strong>Java Edition:</strong> open the Minecraft Launcher, go to the Skins tab, click "New skin" and select the file.</li>
      <li><strong>Bedrock:</strong> import the PNG through the Dressing Room where your platform allows custom files, or pack it into a custom skin pack.</li>
    </ol>
    <h2>FAQ</h2>
    <details><summary>Are these Minecraft skins free to download?</summary><p>Yes. Every skin here is an original Minepedia design, free as a standard 64x64 PNG for Java and Bedrock. No account, no watermark.</p></details>
    <details><summary>How do I apply a downloaded skin?</summary><p>On Java Edition, add the PNG in the Minecraft Launcher's Skins tab. On Bedrock, use the Dressing Room import where available or a custom skin pack.</p></details>
    <details><summary>Can I edit a skin before using it?</summary><p>Yes - every card has an Edit button that opens the skin in our free <a href="/tools/skin-maker/">Skin Maker</a>, where you can repaint anything and download your version.</p></details>
    <details><summary>Are these official Minecraft skins?</summary><p>No. All designs are original fan art drawn by Minepedia. Not an official Minecraft product; not approved by or associated with Mojang or Microsoft.</p></details>
  </div>
  <style>
    .skin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px;margin:14px 0 8px}
    .skin-card{background:#14181f;border:1px solid #232a35;border-radius:12px;padding:12px;text-align:center}
    .skin-card h3{font-size:14px;margin:8px 0 8px}
    .skin-card h3 a{color:#e6ebf1;text-decoration:none}
    .skin-card h3 a:hover{color:#3aa655}
    .skin-prev{display:block;background:#0d1015;border-radius:10px;padding:6px}
    .skin-prev canvas{image-rendering:pixelated;width:80px;height:160px}
    .skin-actions{display:flex;gap:6px;justify-content:center}
    .sbtn{font-size:12px;padding:6px 10px;border-radius:8px;border:1px solid #2c3542;background:#1c222c;color:#e6ebf1;text-decoration:none}
    .sbtn:hover{border-color:#3aa655}
    .sbtn.primary{background:#3aa655;border-color:#3aa655;color:#0b0e12;font-weight:700}
  </style>
  <script src="/js/skin-preview.js" is:inline></script>
</Base>
