---
import Base from '../../layouts/Base.astro';
import guides from '../../data/guides.json';
import GameShot from '../../components/GameShot.astro';
export function getStaticPaths() {
  return guides.map(g => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const SHOT_BY_SLUG = { 'how-to-find-diamonds': 'guides-mining-diamonds', 'how-to-find-end-city': 'structures-end-city' };
const shotId = SHOT_BY_SLUG[g.slug];
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'HowTo',
    name: g.name,
    description: g.quickAnswer,
    step: g.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s }))
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://minepedia.app/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://minepedia.app/guides/' },
      { '@type': 'ListItem', position: 3, name: g.shortTitle, item: `https://minepedia.app/guides/${g.slug}/` }
    ]
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: g.faq.map(f => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a }
    }))
  }
];
---
<Base title={g.name} description={`${g.name}: ${g.quickAnswer.slice(0, 150)}`} canonicalPath={`/guides/${g.slug}/`} jsonLd={jsonLd} ogType="article">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / <a href="/guides/">Guides</a> / {g.shortTitle}</nav>
    <h1>{g.name}</h1>
    <p><span class="badge">Guide</span> <span class="badge java">Java</span> <span class="badge bedrock">Bedrock</span></p>
    <div class="quick-answer"><strong>Quick answer:</strong> {g.quickAnswer}</div>
    {shotId && <GameShot id={shotId} />}
    <h2>What you need</h2>
    <ul>{g.materials.map(m => <li>{m}</li>)}</ul>
    <h2>Step by step</h2>
    <ol>{g.steps.map(s => <li>{s}</li>)}</ol>
    <h2>Java vs Bedrock</h2>
    <p>{g.editionNote}</p>
    <p style="color:var(--text-dim);font-size:.9rem"><strong>Versions:</strong> {g.versions}</p>
    <h2>Frequently asked questions</h2>
    {g.faq.map(f => (
      <div>
        <h3 style="font-size:1.05rem;margin-bottom:4px">{f.q}</h3>
        <p style="margin-top:0">{f.a}</p>
      </div>
    ))}
    {(g.relatedGuides.length > 0 || g.relatedLinks.length > 0) && (
      <p><strong>Related:</strong>
        {g.relatedGuides.map(rel => {
          const t = guides.find(x => x.slug === rel);
          return t ? <a href={`/guides/${rel}/`} style="margin-right:12px">{t.name}</a> : null;
        })}
        {g.relatedLinks.map(l => <a href={l.url} style="margin-right:12px">{l.label}</a>)}
      </p>
    )}
  </div>
</Base>
