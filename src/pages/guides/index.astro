---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import guides from '../../data/guides.json';
import GameShot from '../../components/GameShot.astro';
---
<Base title="Minecraft Guides" description="Evergreen Minecraft guides: how to find diamonds, make a nether portal, tame horses, breed villagers, get elytra, enchant and more. Java and Bedrock." canonicalPath="/guides/">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / Guides</nav>
    <h1>Minecraft Guides</h1>
    <p class="sub">{guides.length} step-by-step guides with quick answers, materials and FAQs.</p>
    <SearchBox placeholder="Search guides, items, commands..." />
    <GameShot id="guides-block-breaking" />
    <div class="grid-cards" style="margin-top:24px">
      {guides.map(g => (
        <a class="card" href={`/guides/${g.slug}/`}>
          <img class="pixel-icon" src={`/item-icons/${g.slug}.svg`} alt="" width="34" height="34" style="margin-bottom:12px" />
          <h3>{g.name}</h3>
          <p>{g.quickAnswer.split('.')[0]}.</p>
        </a>
      ))}
    </div>
  </div>
</Base>
