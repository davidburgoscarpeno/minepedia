  { '@context': 'https://schema.org', '@type': 'HowTo',
    name: 'How to make a Minecraft server (Java Edition)',
    description: 'Set up a vanilla or Paper Minecraft server and let friends connect.',
    step: [
      { '@type': 'HowToStep', position: 1, text: 'Download the official server jar (or Paper) and put it in an empty folder.' },
      { '@type': 'HowToStep', position: 2, text: 'Run it once, then edit eula.txt and set eula=true.' },
