---
import Base from '../../../layouts/Base.astro';
const plugins = [
  { name: 'LuckPerms', what: 'Permissions manager: groups, ranks and who can use which command. The first plugin on every serious server.' },
  { name: 'EssentialsX', what: 'The classic command pack: /home, /spawn, /warp, /tpa, kits, economy basics and player messaging.' },
  { name: 'GeyserMC + Floodgate', what: 'Lets Bedrock players (console, mobile) join your Java server. The standard cross-play bridge.' },
  { name: 'ViaVersion', what: 'Lets players on different Minecraft versions join the same server - no more "update your game" fights.' },
  { name: 'CoreProtect', what: 'Logs every block change. Roll back griefing in seconds and see exactly who broke what.' },
  { name: 'Chunky', what: 'Pre-generates world chunks so exploring players stop causing lag spikes.' },
  { name: 'BlueMap or Dynmap', what: 'A live 3D map of your world in the browser. Great for community servers.' },
  { name: 'DiscordSRV', what: 'Links server chat with a Discord channel: talk to in-game players from your phone.' },
  { name: 'WorldGuard (+ WorldEdit)', what: 'Protect spawn, regions and player builds with rules; WorldEdit for massive admin builds.' },
  { name: 'Vault', what: 'The bridge most economy and shop plugins need. Install it before economy plugins complain.' }
];
---
<Base title="Essential Minecraft Server Plugins" description="The standard Minecraft server plugin stack: LuckPerms, EssentialsX, GeyserMC, ViaVersion, CoreProtect, Chunky and more. What each one does." canonicalPath="/servers/plugins/">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / <a href="/servers/">Servers</a> / Plugins</nav>
    <h1>Essential Server Plugins</h1>
    <p class="sub">The stack almost every Paper server runs. All free, all on Modrinth, Hangar or SpigotMC.</p>
    <div class="quick-answer"><strong>Quick answer:</strong> start with Paper + LuckPerms + EssentialsX + CoreProtect. Add ViaVersion for mixed versions, GeyserMC for console/mobile friends, and Chunky to kill exploration lag.</div>
    {plugins.map(p => (
      <div>
        <h2>{p.name}</h2>
        <p>{p.what}</p>
      </div>
    ))}
    <h2>Plugin rules that save servers</h2>
    <ul>
      <li>Fewer plugins, fewer problems: install what you use, remove what you do not.</li>
      <li>Match plugin versions to your server version - a wrong ViaVersion or ProtocolLib build is the classic crash cause.</li>
      <li>Never give players <code>*</code> permissions or op. LuckPerms groups exist for a reason.</li>
      <li>Download only from Modrinth, Hangar, SpigotMC or the plugin's official GitHub.</li>
    </ul>
  </div>
</Base>
