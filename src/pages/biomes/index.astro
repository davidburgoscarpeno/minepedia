---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import biomes from '../../data/biomes.json';
import GameShot from '../../components/GameShot.astro';
import shots from '../../data/screenshots.json';
const SHOT_BY_SLUG: Record<string, string> = { 'lush-caves': 'biomes-lush-caves', 'jungle': 'biomes-jungle', 'taiga': 'biomes-taiga', 'deep-dark': 'biomes-deep-dark', 'nether-wastes': 'guides-nether', 'the-end': 'structures-end-city' };
const thumb = (slug: string) => { const id = SHOT_BY_SLUG[slug]; const sh = id && shots.find(x => x.id === id); return sh ? '/screenshots/' + sh.file : `/biome-art/${slug}.png`; };
---
<Base title="Minecraft Biomes" description="Minecraft biome guide: resources, mobs, structures and tips for plains, desert, jungle, badlands, deep dark, swamp and more. Java and Bedrock." canonicalPath="/biomes/">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / Biomes</nav>
    <h1>Minecraft Biomes</h1>
    <p class="sub">{biomes.length} biomes: what to find, what to fear and when to go.</p>
    <SearchBox placeholder="Search biomes, mobs, items..." />
    <GameShot id="biomes-frozen-ocean" />
    <div class="grid-cards">
      {biomes.map(b => (
        <a class="card" href={`/biomes/${b.slug}/`}>
          <img src={thumb(b.slug)} alt={`Minecraft ${b.name} biome`} width="256" height="144" loading="lazy" style="width:100%;height:auto;border-radius:8px;margin-bottom:8px;image-rendering:pixelated" />
          <h3>{b.name}</h3>
          <p>{b.description.split('.')[0]}.</p>
        </a>
      ))}
    </div>
    <p style="margin-top:24px">Tip: find any biome in your world with the <a href="/commands/locate/">/locate biome</a> command (cheats on), or by exploring with a <a href="/villagers/cartographer/">cartographer's</a> maps for structure hunts.</p>
  </div>
</Base>
