---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
const TILE: Record<string, [string, string]> = {
  Material: ['#6ab0f3', '#3a6fb0'], Utility: ['#e8b93e', '#b8891f'], Block: ['#a89a8a', '#7a6a5a'],
  Combat: ['#ef7a7a', '#c04848'], Weapon: ['#ef7a7a', '#c04848']
};
const initials = (n: string) => n.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
import items from '../../data/items.json';
---
<Base title="Minecraft Items" description="Minecraft item database: how to get diamonds, netherite, elytra, tridents, totems and more, with uses and Java/Bedrock notes." canonicalPath="/items/">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / Items</nav>
    <h1>Minecraft Items</h1>
    <p class="sub">{items.length} key items: where to find them, what they do and how to farm them.</p>
    <SearchBox placeholder="Search items, recipes, mobs..." />
    <div class="grid-cards">
      {items.map(i => {
        const [a, b] = TILE[i.category] || TILE.Material;
        return (
        <a class="card entity-card" href={`/items/${i.slug}/`}>
          <span class="mob-tile" style={`--tile-a:${a};--tile-b:${b}`}>{initials(i.name)}</span>
          <div>
            <h3>{i.name}<span class="type-chip type-neutral">{i.category}</span></h3>
            <p class="meta"><b>Get:</b> {i.howToGet[0].split(' - ')[0].split(':')[0]}</p>
          </div>
        </a>
      )})}
    </div>
  </div>
</Base>
