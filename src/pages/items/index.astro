---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import items from '../../data/items.json';
---
<Base title="Minecraft Items" description="Minecraft item database: how to get diamonds, netherite, elytra, tridents, totems and more, with uses and Java/Bedrock notes." canonicalPath="/items/">
  <div class="container">
    <nav class="crumbs"><a href="/">Home</a> / Items</nav>
    <h1>Minecraft Items</h1>
    <p class="sub">{items.length} key items: where to find them, what they do and how to farm them.</p>
    <SearchBox placeholder="Search items, recipes, mobs..." />
    <div class="grid-cards">
      {items.map(i => (
        <a class="card" href={`/items/${i.slug}/`}>
          <h3>{i.name}</h3>
          <p>{i.howToGet[0].split(' - ')[0].split(':')[0]}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
