---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import mobs from '../../data/mobs.json';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const TILE: Record<string, [string, string]> = {
  hostile: ['#ef7a7a', '#c04848'], passive: ['#6fdd73', '#3d8b40'], neutral: ['#e8b93e', '#b8891f'], boss: ['#c08ef0', '#8b52c4']
};
const tileOf = (t: string) => t.startsWith('Hostile') ? TILE.hostile : t.startsWith('Boss') ? TILE.boss : t.startsWith('Neutral') ? TILE.neutral : TILE.passive;
const chipOf = (t: string) => t.startsWith('Hostile') ? 'type-hostile' : t.startsWith('Boss') ? 'type-boss' : t.startsWith('Neutral') ? 'type-neutral' : 'type-passive';
const heartsOf = (h: string) => { const m = h.match(/\((\d+) hearts?\)/); return m ? parseInt(m[1]) : 0; };
const initials = (n: string) => n.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
const PIXEL = new Set(['allay','armadillo','axolotl','bat','bee','blaze','bogged','breeze','camel','cat','cave-spider','chicken','cod','copper-golem','cow','creaking','creeper','dolphin','donkey','drowned','elder-guardian','ender-dragon','enderman','evoker','fox','frog','ghast','glow-squid','goat','guardian','happy-ghast','hoglin','horse','husk','iron-golem','llama','magma-cube','mooshroom','nautilus','ocelot','panda','parched','parrot','phantom','pig','piglin','piglin-brute','pillager','polar-bear','pufferfish','rabbit','ravager','salmon','sheep','shulker','silverfish','skeleton','skeleton-horse','slime','sniffer','snow-golem','spider','squid','stray','strider','sulfur-cube','tropical-fish','turtle','vex','villager','vindicator','wandering-trader','warden','witch','wither','wither-skeleton','wolf','zoglin','zombie','zombie-nautilus','zombie-villager','zombified-piglin']);
const HEART = 'M12 21c-4.8-3.6-8-6.6-8-10a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 11c0 3.4-3.2 6.4-8 10z';
const TYPE_ES: Record<string, string> = { 'Hostile': 'Hostil', 'Neutral (tameable)': 'Neutral (adestrable)', 'Neutral (hostile in darkness)': 'Neutral (hostil en la oscuridad)', 'Neutral': 'Neutral', 'Passive': 'Pasivo', 'Passive (aquatic)': 'Pasivo (acuático)', 'Passive (ambient)': 'Pasivo (ambiental)', 'Boss': 'Jefe' };
const typeLabel = (t: string) => lang === 'es' ? (TYPE_ES[t] ?? t) : t;
const chipLabel = (t: string) => typeLabel(t.split(' (')[0]);
const present = [...new Set(mobs.map(m => m.type))];
const S = lang === 'es' ? {
  title: 'Mobs de Minecraft',
  description: 'Base de datos de mobs de Minecraft: drops, condiciones de aparición, comportamiento y cómo matar, domar o criar cada mob. Java y Bedrock.',
  h1: 'Mobs de Minecraft',
  sub: `${mobs.length} mobs con drops, condiciones de aparición y estrategias.`,
  crumb: 'Mobs', home: 'Inicio',
  placeholder: 'Busca mobs, objetos, comandos...',
  drops: 'Drops:', none: 'Ninguno',
  canonical: '/es/mobs/', alt: '/mobs/'
} : {
  title: 'Minecraft Mobs',
  description: 'Minecraft mob database: drops, spawn conditions, behavior, how to kill, tame or breed every mob. Java and Bedrock.',
  h1: 'Minecraft Mobs',
  sub: `${mobs.length} mobs with drops, spawn conditions and strategies.`,
  crumb: 'Mobs', home: 'Home',
  placeholder: 'Search mobs, items, commands...',
  drops: 'Drops:', none: 'None',
  canonical: '/mobs/', alt: '/es/mobs/'
};
---
<Base title={S.title} description={S.description} canonicalPath={S.canonical} lang={lang} altPath={S.alt}>
  <div class="container">
    <nav class="crumbs"><a href={lang === 'es' ? '/es/' : '/'}>{S.home}</a> / {S.crumb}</nav>
    <h1>{S.h1}</h1>
    <p class="sub">{S.sub}</p>
    <SearchBox placeholder={S.placeholder} lang={lang} />
    {present.map(t => (
      <section class="section">
        <h2>{typeLabel(t)}</h2>
        <div class="grid-cards">
          {mobs.filter(m => m.type === t).map(m => {
            const [a, b] = tileOf(m.type);
            const hearts = heartsOf(m.health);
            return (
            <a class="card entity-card" href={lang === 'es' ? `/es/mobs/${m.slug}/` : `/mobs/${m.slug}/`}>
              {PIXEL.has(m.slug)
                ? <img src={`/mobs/${m.slug}.svg`} alt="" width="40" height="40" class="pixel-icon" />
                : <span class="mob-tile" style={`--tile-a:${a};--tile-b:${b}`}>{initials(m.name)}</span>}
              <div>
                <h3>{m.name}<span class={`type-chip ${chipOf(m.type)}`}>{chipLabel(m.type)}</span></h3>
                {hearts > 0 && (
                  <span class="hearts">
                    {Array.from({ length: Math.min(hearts, 10) }).map(() => <svg viewBox="0 0 24 24"><path d={HEART}/></svg>)}
                    {hearts > 10 && <span class="more">+{hearts - 10}</span>}
                  </span>
                )}
                <p class="meta"><b>{S.drops}</b> {m.drops.map(d => d.item.split('(')[0].trim()).filter((v,i,a) => a.indexOf(v)===i).join(', ') || S.none}</p>
              </div>
            </a>
          )})}
        </div>
      </section>
    ))}
  </div>
</Base>
