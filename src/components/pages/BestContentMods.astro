---
import Base from '../../layouts/Base.astro';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const isES = lang === 'es';

const S = isES ? {
  title: 'Los mejores mods de contenido de Minecraft',
  description: 'Los mejores mods de contenido de Minecraft: Create, Botania, Twilight Forest, Applied Energistics 2, Farmer\'s Delight, Terralith y más. Qué añade cada uno y qué loader necesita.',
  h1: 'Los mejores mods de contenido',
  sub: 'Seleccionados a mano, gratis y con mantenimiento activo. Revisa la página de cada mod para tu versión del juego antes de instalar.',
  crumb: 'Mods de contenido', modsCrumb: 'Mods', home: 'Inicio',
  quickAnswer: '<strong>Respuesta rápida:</strong> ¿quieres máquinas y automatización que encajen con vanilla? Create. ¿Un segundo juego dentro del primero? Twilight Forest. ¿Mejor worldgen sin bloques nuevos? Terralith. ¿Cocina acogedora? Farmer\'s Delight. ¿Más animales? Alex\'s Mobs.',
  mods: [
    { name: 'Create', loader: 'NeoForge (existe port a Fabric)', what: 'Energía rotacional, engranajes, correas, trenes y artilugios automatizados que parecen parte de vanilla. El mod técnico más querido jamás hecho: las construcciones son máquinas, no cajas mágicas.' },
    { name: 'Botania', loader: 'NeoForge', what: 'Tecnología disfrazada de magia: genera maná con flores y automatízalo con lógica sin redstone. Precioso, autoequilibrado e infinitamente creativo.' },
    { name: 'Twilight Forest', loader: 'NeoForge', what: 'Una dimensión completamente nueva con mazmorras, jefes y progresión de botín. El mod de aventuras clásico: parece una expansión oficial.' },
    { name: 'Applied Energistics 2', loader: 'NeoForge', what: 'Almacenamiento digital y redes de autocrafteo. Cuando tu sala de cofres necesita una base de datos, es esto.' },
    { name: 'Mekanism', loader: 'NeoForge', what: 'Tecnología industrial completa: procesado de minerales hasta x5, fábricas, reactores de fusión. Profundo pero bien documentado dentro del juego.' },
    { name: 'Farmer\'s Delight', loader: 'NeoForge / Fabric', what: 'Expansión de cocina y agricultura con fogones, tablas de cortar y docenas de platos que encajan perfectamente con vanilla. El mod acogedor.' },
    { name: 'Alex\'s Mobs', loader: 'NeoForge', what: 'Unos 90 animales y criaturas nuevas con comportamientos y botines reales. El mejor mod de mobs para jugar estilo vanilla.' },
    { name: 'Terralith', loader: 'Fabric / NeoForge (también datapack)', what: 'Casi 100 biomas nuevos construidos con bloques vanilla: worldgen que parece 1.18 al cuadrado. Sin bloques nuevos, funciona en servidores sin clientes modeados.' },
    { name: 'Supplementaries', loader: 'NeoForge / Fabric', what: 'Docenas de pequeños bloques y objetos vanilla-plus: cuerdas, tarros, carteles, globos. Todo parece que debería haber venido con el juego.' },
    { name: 'Waystones', loader: 'NeoForge / Fabric', what: 'Piedras de teletransporte crafteables para viajes largos. La respuesta de calidad de vida a las megabases distantes.' },
    { name: 'Cobblemon', loader: 'Fabric / NeoForge', what: 'Pokémon en Minecraft, de código abierto y respetuoso con vanilla. Captura, combate y construye con criaturas que se integran en el mundo.' }
  ],
  beforeH2: 'Antes de instalar mods de contenido',
  before: [
    'Haz copia de seguridad de tu mundo. Los mods de contenido añaden bloques y objetos a tu partida: quitar el mod después los borra.',
    'Coincide la versión del juego exactamente, y prefiere un solo ecosistema de loader por instancia (los mods de NeoForge y de Fabric no se mezclan).',
    'Para servidores: normalmente todos los jugadores necesitan los mismos mods de contenido instalados. Los mods de rendimiento son del lado del cliente y opcionales para cada jugador.'
  ],
  canonical: '/es/mods/best-content-mods/', alt: '/mods/best-content-mods/'
} : {
  title: 'Best Minecraft Content Mods',
  description: 'The best Minecraft content mods: Create, Botania, Twilight Forest, Applied Energistics 2, Farmer\'s Delight, Terralith and more. What each adds and which loader it needs.',
  h1: 'Best Content Mods',
  sub: 'Hand-picked, free, and actively maintained. Check each mod\'s page for your game version before installing.',
  crumb: 'Content Mods', modsCrumb: 'Mods', home: 'Home',
  quickAnswer: '<strong>Quick answer:</strong> want machines and automation that fit vanilla? Create. A second game inside the first? Twilight Forest. Better worldgen without new blocks? Terralith. Cozy cooking? Farmer\'s Delight. More animals? Alex\'s Mobs.',
  mods: [
    { name: 'Create', loader: 'NeoForge (Fabric port exists)', what: 'Rotational power, cogs, belts, trains and automated contraptions that look like they belong in vanilla. The most beloved tech mod ever made - builds are machines, not magic boxes.' },
    { name: 'Botania', loader: 'NeoForge', what: 'Tech disguised as magic: generate mana with flowers, automate it with redstone-free logic. Beautiful, self-balancing and endlessly creative.' },
    { name: 'Twilight Forest', loader: 'NeoForge', what: 'A whole new dimension with dungeons, bosses and loot progression. The classic adventure mod - feels like an official expansion.' },
    { name: 'Applied Energistics 2', loader: 'NeoForge', what: 'Digital storage and auto-crafting networks. When your chest room needs a database, this is it.' },
    { name: 'Mekanism', loader: 'NeoForge', what: 'Full industrial tech: ore processing up to 5x, factories, fusion reactors. Deep but well-documented in-game.' },
    { name: 'Farmer\'s Delight', loader: 'NeoForge / Fabric', what: 'Cooking and farming expansion with stoves, cutting boards and dozens of dishes that fit vanilla perfectly. The cozy mod.' },
    { name: 'Alex\'s Mobs', loader: 'NeoForge', what: 'Around 90 new animals and creatures with real behaviors and drops. The best mob mod for vanilla-style play.' },
    { name: 'Terralith', loader: 'Fabric / NeoForge (also a datapack)', what: 'Nearly 100 new biomes built from vanilla blocks - worldgen that feels like 1.18 squared. No new blocks, works on servers without clients modded.' },
    { name: 'Supplementaries', loader: 'NeoForge / Fabric', what: 'Dozens of small vanilla-plus blocks and items: ropes, jars, signs, globes. Everything feels like it should have shipped with the game.' },
    { name: 'Waystones', loader: 'NeoForge / Fabric', what: 'Craftable teleport stones for long-distance travel. The quality-of-life answer to mega-bases far apart.' },
    { name: 'Cobblemon', loader: 'Fabric / NeoForge', what: 'Pokemon in Minecraft, open source and vanilla-friendly. Catch, battle and build with creatures that blend into the world.' }
  ],
  beforeH2: 'Before you install content mods',
  before: [
    'Back up your world. Content mods add blocks and items to your save - removing the mod later deletes them.',
    'Match the game version exactly, and prefer one loader ecosystem per instance (NeoForge mods and Fabric mods do not mix).',
    'For servers: every player usually needs the same content mods installed. Performance mods are client-side and optional per player.'
  ],
  canonical: '/mods/best-content-mods/', alt: '/es/mods/best-content-mods/'
};
---
<Base title={S.title} description={S.description} canonicalPath={S.canonical} lang={lang} altPath={S.alt}>
  <div class="container">
    <nav class="crumbs"><a href={isES ? '/es/' : '/'}>{S.home}</a> / <a href={isES ? '/es/mods/' : '/mods/'}>{S.modsCrumb}</a> / {S.crumb}</nav>
    <h1>{S.h1}</h1>
    <p class="sub">{S.sub}</p>
    <div class="quick-answer" set:html={S.quickAnswer}></div>
    {S.mods.map(m => (
      <div>
        <h2>{m.name} <span class="badge">{m.loader}</span></h2>
        <p>{m.what}</p>
      </div>
    ))}
    <h2>{S.beforeH2}</h2>
    <ul>
      {S.before.map(x => <li>{x}</li>)}
    </ul>
  </div>
</Base>
