---
import Base from '../../layouts/Base.astro';
import skins1 from '../../data/gallery-skins.json';
import skins2 from '../../data/gallery-skins-2.json';
import skinsEs from '../../data/skins-es.json';
const skins = [...skins1, ...skins2];

interface Props { s: any; lang: 'en' | 'es'; }
const { s, lang } = Astro.props;
const isES = lang === 'es';
const CAT_ES: Record<string, string> = { 'Animals': 'Animales', 'Fantasy & Adventure': 'Fantasía y aventura', 'Gamers': 'Gamers', 'Professions': 'Profesiones', 'Sci-Fi': 'Ciencia ficción', 'Seasonal': 'De temporada', 'Sports': 'Deportes', 'Styles': 'Estilos' };
const desc = isES ? ((skinsEs as any)[s.slug] ?? s.desc) : s.desc;
const category = isES ? (CAT_ES[s.category] ?? s.category) : s.category;
const related = skins.filter(x => x.category === s.category && x.slug !== s.slug).slice(0, 4);

const L = isES ? {
  home: 'Inicio', homeHref: '/es/', crumb: 'Skins', crumbHref: '/es/skins/',
  canonical: `/es/skins/${s.slug}/`, alt: `/skins/${s.slug}/`, skinHref: (slug: string) => `/es/skins/${slug}/`,
  h1: `${s.name} - skin de Minecraft`,
  title: `${s.name} - skin de Minecraft gratis`,
  headline: `${s.name} - skin de Minecraft gratis`,
  front: 'Frente', side: 'Lado', back: 'Espalda',
  dl: '⬇️ Descargar PNG (64x64)', edit: '🎨 Editar en Skin Maker', dlShort: '⬇️ PNG', editShort: '🎨 Editar',
  applyH: 'Cómo aplicar esta skin',
  java: 'Minecraft Launcher → pestaña Skins → Nueva skin → selecciona el PNG descargado.',
  bedrock: 'importa desde el Vestidor donde tu plataforma permita archivos propios, o mete el PNG en un skin pack personalizado.',
  moreH: `Más skins de ${category.toLowerCase()}`,
  metaDesc: `${desc} Descarga gratuita en PNG 64x64 para Java y Bedrock, o edítala online en el Skin Maker de Minepedia.`
} : {
  home: 'Home', homeHref: '/', crumb: 'Skins', crumbHref: '/skins/',
  canonical: `/skins/${s.slug}/`, alt: `/es/skins/${s.slug}/`, skinHref: (slug: string) => `/skins/${slug}/`,
  h1: `${s.name} Minecraft Skin`,
  title: `${s.name} Minecraft Skin - Free Download`,
  headline: `${s.name} - Free Minecraft Skin Download`,
  front: 'Front', side: 'Side', back: 'Back',
  dl: '⬇️ Download PNG (64x64)', edit: '🎨 Edit in Skin Maker', dlShort: '⬇️ PNG', editShort: '🎨 Edit',
  applyH: 'How to apply this skin',
  java: 'Minecraft Launcher → Skins tab → New skin → select the downloaded PNG.',
  bedrock: 'Dressing Room import where your platform allows custom files, or pack the PNG into a custom skin pack.',
  moreH: `More ${s.category.toLowerCase()} skins`,
  metaDesc: `${desc} Free 64x64 PNG download for Java and Bedrock, or edit it online in the Minepedia Skin Maker.`
};

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Article',
    headline: L.headline,
    description: desc,
    mainEntityOfPage: `https://minepedia.app${L.canonical}`,
    author: { '@type': 'Organization', name: 'Minepedia' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: L.home, item: `https://minepedia.app${L.homeHref}` },
      { '@type': 'ListItem', position: 2, name: L.crumb, item: `https://minepedia.app${L.crumbHref}` },
      { '@type': 'ListItem', position: 3, name: s.name, item: `https://minepedia.app${L.canonical}` }
    ] }
];
---
<Base title={L.title} description={L.metaDesc} canonicalPath={L.canonical} jsonLd={jsonLd} ogType="article" lang={lang} altPath={L.alt}>
  <div class="container">
    <nav class="crumbs"><a href={L.homeHref}>{L.home}</a> / <a href={L.crumbHref}>{L.crumb}</a> / {s.name}</nav>
    <h1>{L.h1}</h1>
    <p><span class="badge">{category}</span></p>
    <p>{desc}</p>
    <div class="skinhero">
      <figure><canvas class="skinview" data-src={s.file} data-view="front" data-scale="9" width="144" height="288"></canvas><figcaption>{L.front}</figcaption></figure>
      <figure><canvas class="skinview" data-src={s.file} data-view="side" data-scale="9" width="144" height="288"></canvas><figcaption>{L.side}</figcaption></figure>
      <figure><canvas class="skinview" data-src={s.file} data-view="back" data-scale="9" width="144" height="288"></canvas><figcaption>{L.back}</figcaption></figure>
    </div>
    <div class="skin-cta">
      <a class="sbtn primary" href={s.file} download={`minepedia-${s.slug}-skin.png`}>{L.dl}</a>
      <a class="sbtn" href={`/tools/skin-maker/?skin=${s.file}`}>{L.edit}</a>
    </div>
    <h2>{L.applyH}</h2>
    <ol>
      <li><strong>Java Edition:</strong> {L.java}</li>
      <li><strong>Bedrock:</strong> {L.bedrock}</li>
    </ol>
    <p class="note">Original fan art by Minepedia. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.</p>
    {related.length > 0 && (
      <section>
        <h2>{L.moreH}</h2>
        <div class="skin-grid">
          {related.map(r => (
            <div class="skin-card">
              <a href={L.skinHref(r.slug)} class="skin-prev"><canvas class="skinview" data-src={r.file} data-view="front" data-scale="5" width="80" height="160"></canvas></a>
              <h3><a href={L.skinHref(r.slug)}>{r.name}</a></h3>
              <div class="skin-actions">
                <a class="sbtn primary" href={r.file} download={`minepedia-${r.slug}-skin.png`}>{L.dlShort}</a>
                <a class="sbtn" href={`/tools/skin-maker/?skin=${r.file}`}>{L.editShort}</a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
  <style>
    .skinhero{display:flex;gap:16px;flex-wrap:wrap;margin:18px 0}
    .skinhero figure{margin:0;text-align:center;background:#0d1015;border:1px solid #232a35;border-radius:12px;padding:12px}
    .skinhero canvas{image-rendering:pixelated;width:144px;height:288px}
    .skinhero figcaption{font-size:11px;color:#7d8894;margin-top:6px}
    .skin-cta{display:flex;gap:10px;margin:6px 0 10px;flex-wrap:wrap}
    .sbtn{font-size:14px;padding:10px 16px;border-radius:10px;border:1px solid #2c3542;background:#1c222c;color:#e6ebf1;text-decoration:none}
    .sbtn:hover{border-color:#3aa655}
    .sbtn.primary{background:#3aa655;border-color:#3aa655;color:#0b0e12;font-weight:700}
    .note{font-size:12px;color:#7d8894}
    .skin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px;margin:14px 0 8px}
    .skin-card{background:#14181f;border:1px solid #232a35;border-radius:12px;padding:12px;text-align:center}
    .skin-card h3{font-size:14px;margin:8px 0}
    .skin-card h3 a{color:#e6ebf1;text-decoration:none}
    .skin-card h3 a:hover{color:#3aa655}
    .skin-prev{display:block;background:#0d1015;border-radius:10px;padding:6px}
    .skin-prev canvas{image-rendering:pixelated;width:80px;height:160px}
    .skin-actions{display:flex;gap:6px;justify-content:center}
    .skin-actions .sbtn{font-size:12px;padding:6px 10px}
  </style>
  <script src="/js/skin-preview.js" is:inline></script>
</Base>
