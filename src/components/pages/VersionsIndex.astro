---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import versions from '../../data/versions.json';
import versionsEs from '../../data/versions-es.json';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const isES = lang === 'es';
const dateOf = (v: any) => isES && (versionsEs as any)[v.slug] ? (versionsEs as any)[v.slug].date : v.date;

const S = isES ? {
  title: 'Versiones de Minecraft',
  description: 'Historia de versiones de Minecraft: qué añadió cada actualización desde la 1.20 Trails & Tales hasta la 26.3 Wilderness Bound, y cómo funciona la nueva numeración 26.x. Java y Bedrock.',
  h1: 'Versiones de Minecraft',
  sub: 'Actual: Java Edition 26.3 "Wilderness Bound" (15 de septiembre de 2026) - Bedrock Edition 26.50.',
  crumb: 'Versiones', home: 'Inicio',
  placeholder: 'Busca versiones, objetos, mobs...',
  quick: '<strong>Cómo funcionan ahora los números de versión:</strong> tras la serie 1.21, Mojang cambió a una numeración por año: Java Edition 26.1, 26.2, 26.3 (drops de 2026), mientras Bedrock usa sus propios números (26.10, 26.30, 26.50). El contenido ahora llega en varios "drops" con nombre al año en lugar de una única gran actualización anual.',
  historyH: 'Historia de versiones',
  cardHref: (slug: string) => `/es/versions/${slug}/`,
  jbH: 'Java vs Bedrock: ¿cuál tienes tú?',
  jbP1: '<strong>Java Edition</strong> funciona en PC, Mac y Linux. Tiene mods, servidores personalizados, información de depuración con F3, combate más duro (enfriamiento de ataque) y recibe las snapshots primero. <strong>Bedrock Edition</strong> funciona en consolas, móvil y Windows 10/11, tiene cross-play entre todas ellas, mejor rendimiento y algunas diferencias mecánicas: más drops de tridentes, redstone distinta (sin quasi-connectivity), wither y raids con comportamiento diferente, y contenido de marketplace.',
  jbP2: 'En Minepedia, cada página marca las diferencias entre ediciones donde importan: busca las insignias <span class="badge java">Java</span> y <span class="badge bedrock">Bedrock</span>.',
  canonical: '/es/versions/', alt: '/versions/'
} : {
  title: 'Minecraft Versions',
  description: 'Minecraft version history: what every update added from 1.20 Trails & Tales to 26.3 Wilderness Bound, plus how the new 26.x numbering works. Java and Bedrock.',
  h1: 'Minecraft Versions',
  sub: 'Current: Java Edition 26.3 "Wilderness Bound" (September 15, 2026) - Bedrock Edition 26.50.',
  crumb: 'Versions', home: 'Home',
  placeholder: 'Search versions, items, mobs...',
  quick: '<strong>How version numbers work now:</strong> after the 1.21 series, Mojang switched to year-based numbering: Java Edition 26.1, 26.2, 26.3 (2026 drops), while Bedrock uses its own numbers (26.10, 26.30, 26.50). Content now arrives as several named "drops" per year instead of one huge annual update.',
  historyH: 'Version history',
  cardHref: (slug: string) => `/versions/${slug}/`,
  jbH: 'Java vs Bedrock: which one do you have?',
  jbP1: '<strong>Java Edition</strong> runs on PC, Mac and Linux. It has mods, custom servers, F3 debug info, harder combat (attack cooldown) and gets snapshots first. <strong>Bedrock Edition</strong> runs on consoles, mobile and Windows 10/11, has cross-play between all of them, smoother performance, and some mechanical differences: stronger trident drops, different redstone (no quasi-connectivity), different wither and raid behavior, and market-place content.',
  jbP2: 'On Minepedia, every page flags edition differences where they matter: look for the <span class="badge java">Java</span> and <span class="badge bedrock">Bedrock</span> badges.',
  canonical: '/versions/', alt: '/es/versions/'
};
---
<Base title={S.title} description={S.description} canonicalPath={S.canonical} lang={lang} altPath={S.alt}>
  <div class="container">
    <nav class="crumbs"><a href={isES ? '/es/' : '/'}>{S.home}</a> / {S.crumb}</nav>
    <h1>{S.h1}</h1>
    <p class="sub">{S.sub}</p>
    <SearchBox placeholder={S.placeholder} />

    <div class="quick-answer" set:html={S.quick}></div>

    <h2>{S.historyH}</h2>
    <div class="grid-cards">
      {versions.map(v => (
        <a class="card" href={S.cardHref(v.slug)}>
          <img class="pixel-icon" src={`/item-icons/v-${v.slug}.svg`} alt="" width="34" height="34" style="margin-bottom:12px" />
          <h3>{v.name}</h3>
          <p>{dateOf(v)}</p>
        </a>
      ))}
    </div>

    <h2 style="margin-top:32px">{S.jbH}</h2>
    <p set:html={S.jbP1}></p>
    <p set:html={S.jbP2}></p>
  </div>
</Base>
