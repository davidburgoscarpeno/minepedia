---
import Base from '../../layouts/Base.astro';
import guides from '../../data/guides.json';
import guidesEs from '../../data/guides-es.json';
import GameShot from '../../components/GameShot.astro';

interface Props { g: any; lang: 'en' | 'es'; }
const { g, lang } = Astro.props;
const isES = lang === 'es';
const ov: any = isES ? (guidesEs as any)[g.slug] : null;
const name = ov?.name ?? g.name;
const shortTitle = ov?.shortTitle ?? g.shortTitle;
const quickAnswer = ov?.quickAnswer ?? g.quickAnswer;
const steps = ov?.steps ?? g.steps;
const materials = ov?.materials ?? g.materials;
const editionNote = ov?.editionNote ?? g.editionNote;
const versions = ov?.versions ?? g.versions;
const faq = ov?.faq ?? g.faq;
const relatedLinks = ov?.relatedLinks ?? g.relatedLinks;

const SHOT_BY_SLUG: Record<string, string> = { 'how-to-find-diamonds': 'guides-mining-diamonds', 'how-to-find-end-city': 'structures-end-city', 'how-to-make-nether-portal': 'guides-nether-portal' };
const shotId = SHOT_BY_SLUG[g.slug];

const L = isES ? {
  home: 'Inicio', homeHref: '/es/', crumb: 'Guías', crumbHref: '/es/guides/',
  guideBadge: 'Guía', quick: 'Respuesta rápida:', needH: 'Qué necesitas', stepsH: 'Paso a paso',
  editionsH: 'Java vs Bedrock', versionsL: 'Versiones:', faqH: 'Preguntas frecuentes', relatedL: 'Relacionados:',
  guideHref: (slug: string) => `/es/guides/${slug}/`,
  canonical: `/es/guides/${g.slug}/`, alt: `/guides/${g.slug}/`
} : {
  home: 'Home', homeHref: '/', crumb: 'Guides', crumbHref: '/guides/',
  guideBadge: 'Guide', quick: 'Quick answer:', needH: 'What you need', stepsH: 'Step by step',
  editionsH: 'Java vs Bedrock', versionsL: 'Versions:', faqH: 'Frequently asked questions', relatedL: 'Related:',
  guideHref: (slug: string) => `/guides/${slug}/`,
  canonical: `/guides/${g.slug}/`, alt: `/es/guides/${g.slug}/`
};

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'HowTo',
    name: name,
    description: quickAnswer,
    step: steps.map((s: string, i: number) => ({ '@type': 'HowToStep', position: i + 1, text: s }))
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: L.home, item: `https://minepedia.app${L.homeHref}` },
      { '@type': 'ListItem', position: 2, name: L.crumb, item: `https://minepedia.app${L.crumbHref}` },
      { '@type': 'ListItem', position: 3, name: shortTitle, item: `https://minepedia.app${L.canonical}` }
    ]
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map((f: any) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a }
    }))
  }
];
---
<Base title={name} description={`${name}: ${quickAnswer.slice(0, 150)}`} canonicalPath={L.canonical} jsonLd={jsonLd} ogType="article" lang={lang} altPath={L.alt}>
  <div class="container">
    <nav class="crumbs"><a href={L.homeHref}>{L.home}</a> / <a href={L.crumbHref}>{L.crumb}</a> / {shortTitle}</nav>
    <h1>{name}</h1>
    <p><span class="badge">{L.guideBadge}</span> <span class="badge java">Java</span> <span class="badge bedrock">Bedrock</span></p>
    <div class="quick-answer"><strong>{L.quick}</strong> {quickAnswer}</div>
    {shotId && <GameShot id={shotId} />}
    <h2>{L.needH}</h2>
    <ul>{materials.map((m: string) => <li>{m}</li>)}</ul>
    <h2>{L.stepsH}</h2>
    <ol>{steps.map((s: string) => <li>{s}</li>)}</ol>
    <h2>{L.editionsH}</h2>
    <p>{editionNote}</p>
    <p style="color:var(--text-dim);font-size:.9rem"><strong>{L.versionsL}</strong> {versions}</p>
    <h2>{L.faqH}</h2>
    {faq.map((f: any) => (
      <div>
        <h3 style="font-size:1.05rem;margin-bottom:4px">{f.q}</h3>
        <p style="margin-top:0">{f.a}</p>
      </div>
    ))}
    {(g.relatedGuides.length > 0 || relatedLinks.length > 0) && (
      <p><strong>{L.relatedL}</strong>
        {g.relatedGuides.map((rel: string) => {
          const t = guides.find((x: any) => x.slug === rel);
          const tOv = isES ? (guidesEs as any)[rel] : null;
          if (!t) return null;
          if (isES && !tOv) return null;
          return <a href={L.guideHref(rel)} style="margin-right:12px">{tOv?.name ?? t.name}</a>;
        })}
        {relatedLinks.map((l: any) => <a href={l.url ?? l.href} style="margin-right:12px">{l.label}</a>)}
      </p>
    )}
  </div>
</Base>
