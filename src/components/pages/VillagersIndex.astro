---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import villagers from '../../data/villagers.json';
import GameShot from '../GameShot.astro';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const isES = lang === 'es';

const S = isES ? {
  title: 'Tradeos de aldeanos de Minecraft (todas las profesiones)',
  description: 'Las 13 profesiones de aldeano, sus bloques de trabajo y tablas completas de tradeos para Java y Bedrock. Restock, descuentos, curación y cómo funciona el comercio.',
  h1: 'Tradeos de aldeanos de Minecraft',
  sub: 'Las 13 profesiones con tablas completas de tradeos, verificadas con la Minecraft Wiki. Java y Bedrock.',
  crumb: 'Aldeanos', home: 'Inicio',
  placeholder: 'Busca aldeanos, mobs, recetas...',
  quick: '<strong>Respuesta rápida:</strong> dale trabajo a un aldeano desempleado colocando un bloque de trabajo a su lado (un lectern hace un librarian, un composter un farmer...). Tradea para subirlo de Novato a Maestro y desbloquear mejores tradeos. Cura aldeanos zombi para descuentos permanentes, y nunca pegues a los aldeanos con los que tradeas.',
  profsH: 'Todas las profesiones',
  workstationL: 'Bloque de trabajo:',
  cardHref: (slug: string) => `/es/villagers/${slug}/`,
  howH: 'Cómo funciona el comercio',
  levelsH: 'Niveles',
  levelsP: 'Los aldeanos empiezan como Novatos y suben de nivel al tradear: Aprendiz (10 XP), Oficial (70), Experto (150) y Maestro (250 XP de aldeano). Su insignia cambia de piedra a hierro, oro, esmeralda y diamante. Cada nivel desbloquea tradeos nuevos: hasta 2 en Java, 1-3 en Bedrock. Cuando un nivel ofrece un grupo de tradeos posibles, el aldeano elige al azar: por eso dos librarians ofrecen libros distintos.',
  lockH: 'Bloquear y cambiar tradeos',
  lockP: 'Antes de tradear con un aldeano, puedes romper y recolocar su bloque de trabajo para rerollear sus tradeos (la forma clásica de pescar un librarian con Mending). En el momento en que completas un tradeo, la profesión y todos los tradeos se bloquean para siempre. Los aldeanos novatos que nunca han tradeado también pueden perder la profesión si se retira el bloque de trabajo.',
  restockH: 'Restock',
  restockP: 'Cada tradeo tiene un stock limitado (normalmente 12-16 usos). Los aldeanos reponen hasta dos veces al día mientras trabajan en su bloque de trabajo. En Bedrock Edition además deben estar vinculados a una cama. Un tradeo agotado muestra una X roja (Java) o un hueco rojo (Bedrock) hasta el siguiente restock.',
  pricesH: 'Precios: demanda, reputación y descuentos',
  prices: [
    '<strong>Demanda:</strong> agotar un tradeo repetidamente sube su precio; dejarlo tranquilo permite que el precio vuelva a bajar.',
    '<strong>Reputación:</strong> tradear genera reputación positiva (pequeños descuentos); pegar o matar aldeanos hace lo contrario, y los golems se vuelven hostiles si tu reputación en la aldea baja lo suficiente (Java).',
    '<strong>Curación:</strong> curar un aldeano zombi (Splash Potion of Weakness + golden apple) da a ese aldeano un gran descuento permanente, que en Bedrock se acumula cuando otros aldeanos cotillean sobre ello.',
    '<strong>Hero of the Village:</strong> ganar una raid rebaja todos los precios un 30% (más un 6,25% por nivel extra) mientras dure el efecto.'
  ],
  nitwitH: 'Nitwits y aldeanos sin trabajo',
  nitwitP: 'Los nitwits de túnica verde nunca pueden trabajar. Los aldeanos desempleados reclaman cualquier bloque de trabajo libre a su alcance: atrapa uno, coloca el bloque que quieras y tendrás la profesión que necesitas. Los aldeanos bebé no pueden trabajar; en Bedrock se convierten en nitwits el 10% de las veces.',
  canonical: '/es/villagers/', alt: '/villagers/',
  headline: 'Tradeos de aldeanos de Minecraft: todas las profesiones y tradeos',
  headlineDesc: 'Cada profesión de aldeano, bloque de trabajo y tabla de tradeos para Java y Bedrock Edition, además de cómo funcionan el comercio, el restock y los descuentos.',
  faq: [
    { q: '¿Cómo se cambia la profesión de un aldeano en Minecraft?', a: 'Retira su bloque de trabajo y coloca uno distinto cerca. El aldeano reclama el nuevo bloque y cambia de profesión. Esto solo funciona si nunca has tradeado con él; tras el primer tradeo, la profesión y los tradeos se bloquean para siempre.' },
    { q: '¿Cómo funciona el restock de los aldeanos?', a: 'Los aldeanos reponen sus tradeos hasta dos veces al día mientras trabajan en su bloque de trabajo. En Bedrock Edition el aldeano también necesita estar vinculado a una cama para reponer.' },
    { q: '¿Cómo se consiguen descuentos en los tradeos?', a: 'Cura un aldeano zombi para un gran descuento permanente de ese aldeano, consigue el efecto Hero of the Village al ganar una raid para un 30% de descuento, y sigue tradeando para acumular reputación positiva. Atacar aldeanos sube los precios.' }
  ]
} : {
  title: 'Minecraft Villager Trades (All Professions)',
  description: 'All 13 villager professions, their workstations and complete trade tables for Java and Bedrock. Restocking, discounts, curing and how trading works.',
  h1: 'Minecraft Villager Trades',
  sub: 'All 13 professions with complete trade tables, verified against the Minecraft Wiki. Java and Bedrock.',
  crumb: 'Villagers', home: 'Home',
  placeholder: 'Search villagers, mobs, recipes...',
  quick: '<strong>Quick answer:</strong> Give an unemployed villager a job by placing a workstation block next to it (a lectern makes a librarian, a composter a farmer...). Trade to level it up from Novice to Master and unlock better trades. Cure zombie villagers for permanent discounts, and never hit villagers you trade with.',
  profsH: 'All professions',
  workstationL: 'Workstation:',
  cardHref: (slug: string) => `/villagers/${slug}/`,
  howH: 'How trading works',
  levelsH: 'Levels',
  levelsP: 'Villagers start at Novice and level up as you trade: Apprentice (10 XP), Journeyman (70), Expert (150) and Master (250 villager XP). Their badge changes from stone to iron, gold, emerald and diamond. Each level unlocks new trades: up to 2 new trades in Java, 1-3 in Bedrock. When a level offers a pool of possible trades, the villager picks randomly - which is why two librarians offer different books.',
  lockH: 'Locking and changing trades',
  lockP: 'Before you trade with a villager, you can break and replace its workstation to reroll its trades (the classic way to fish for a Mending librarian). The moment you complete one trade, the profession and every trade lock forever. Novice villagers that never traded can also lose their profession if the workstation is removed.',
  restockH: 'Restocking',
  restockP: 'Each trade has a limited stock (usually 12-16 uses). Villagers restock up to twice per day while working at their workstation. In Bedrock Edition they must also be linked to a bed. A sold-out trade shows a red X (Java) or a red slot (Bedrock) until the next restock.',
  pricesH: 'Prices: demand, reputation and discounts',
  prices: [
    '<strong>Demand:</strong> buying out a trade repeatedly raises its price; leaving it alone lets the price fall back.',
    '<strong>Reputation:</strong> trading builds positive reputation (small discounts); hitting or killing villagers does the opposite, and golems turn hostile if your village reputation drops far enough (Java).',
    '<strong>Curing:</strong> curing a zombie villager (Splash Potion of Weakness + golden apple) gives that villager a large permanent discount, stacked further in Bedrock when other villagers gossip about it.',
    '<strong>Hero of the Village:</strong> beating a raid cuts all prices by 30% (plus 6.25% per extra level) while the effect lasts.'
  ],
  nitwitH: 'Nitwits and unemployed villagers',
  nitwitP: 'Green-coated nitwits can never take a job. Unemployed villagers claim any free workstation in range - trap one, place the block you want, and you have the profession you need. Baby villagers cannot work; in Bedrock they grow into nitwits 10% of the time.',
  canonical: '/villagers/', alt: '/es/villagers/',
  headline: 'Minecraft Villager Trades: All Professions and Trades',
  headlineDesc: 'Every villager profession, workstation and trade table for Java and Bedrock Edition, plus how trading, restocking and discounts work.',
  faq: [
    { q: 'How do you change a villager profession in Minecraft?', a: 'Remove its job site block and place a different one nearby. The villager claims the new block and changes profession. This only works while you have never traded with it; after the first trade the profession and trades lock forever.' },
    { q: 'How do villager restocks work?', a: 'Villagers restock their trades up to twice per day while working at their job site block. In Bedrock Edition the villager also needs to be linked to a bed to restock.' },
    { q: 'How do you get discounts on villager trades?', a: 'Cure a zombie villager for a large permanent discount from that villager, gain the Hero of the Village effect from beating a raid for a 30% discount, and keep trading to build positive reputation. Attacking villagers raises prices.' }
  ]
};

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: S.headline,
    description: S.headlineDesc,
    mainEntityOfPage: `https://minepedia.app${S.canonical}`,
    author: { '@type': 'Organization', name: 'Minepedia' }
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: S.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
  }
];
---
<Base title={S.title} description={S.description} canonicalPath={S.canonical} jsonLd={jsonLd} ogType="article" lang={lang} altPath={S.alt}>
  <div class="container">
    <nav class="crumbs"><a href={isES ? '/es/' : '/'}>{S.home}</a> / {S.crumb}</nav>
    <h1>{S.h1}</h1>
    <p class="sub">{S.sub}</p>
    <SearchBox placeholder={S.placeholder} />
    <GameShot id="villagers-114" />

    <div class="quick-answer" set:html={S.quick}></div>

    <h2>{S.profsH}</h2>
    <div class="grid-cards">
      {villagers.map(v => (
        <a class="card" href={S.cardHref(v.slug)}>
          <img class="pixel-icon" src={`/item-icons/${v.slug}.svg`} alt="" width="34" height="34" style="margin-bottom:12px" />
          <h3>{v.name}</h3>
          <p>{S.workstationL} {v.workstation}</p>
        </a>
      ))}
    </div>

    <h2>{S.howH}</h2>
    <h3>{S.levelsH}</h3>
    <p>{S.levelsP}</p>
    <h3>{S.lockH}</h3>
    <p>{S.lockP}</p>
    <h3>{S.restockH}</h3>
    <p>{S.restockP}</p>
    <h3>{S.pricesH}</h3>
    <ul>
      {S.prices.map(p => <li set:html={p}></li>)}
    </ul>
    <h3>{S.nitwitH}</h3>
    <p>{S.nitwitP}</p>
  </div>
</Base>
