---
import Base from '../../layouts/Base.astro';
import PotionIcon from '../PotionIcon.astro';
import BrewDiagram from '../BrewDiagram.astro';
import potions from '../../data/potions.json';
import potionsEs from '../../data/potions-es.json';

interface Props { p: any; lang: 'en' | 'es'; }
const { p, lang } = Astro.props;
const isES = lang === 'es';
const ov: any = isES ? (potionsEs as any)[p.slug] : null;
const effect = ov?.effect ?? p.effect;
const duration = ov?.duration ?? p.duration;
const recipe = ov?.recipe ?? p.recipe;
const baseText = ov?.base ?? p.base;
const uses = ov?.uses ?? p.uses;
const variants = ov?.variants ?? p.variants;
const editionNote = ov?.editionNote ?? p.editionNote;

const COLORS: Record<string, string> = {
  'night-vision': '#3a4fa0', 'invisibility': '#c8cdd4', 'swiftness': '#4fd8e0', 'slowness': '#7a8a99',
  'leaping': '#7ed957', 'fire-resistance': '#f08c2e', 'water-breathing': '#2e7ff0', 'healing': '#f05a78',
  'harming': '#a03434', 'poison': '#6aa84f', 'regeneration': '#f07ab0', 'strength': '#d0344c',
  'weakness': '#8a7a6a', 'turtle-master': '#3aa08a', 'slow-falling': '#e8e8f0', 'wind-charging': '#b8e0e8',
  'oozing': '#9acd5a', 'weaving': '#dcdce0', 'infestation': '#9a9a9a'
};
const shortName = p.name.replace('Potion of the ', '').replace('Potion of ', '');
const ingredient = recipe.split(' + ').slice(1).join(' + ').replace(/ \((.*?)\)/, '');
const base = recipe.split(' + ')[0];
const relName = (r: string) => { const rp = potions.find(x => x.slug === r); return rp ? rp.name.replace('Potion of the ', '').replace('Potion of ', '') : r.replace(/-/g, ' '); };

const L = isES ? {
  home: 'Inicio', homeHref: '/es/', crumb: 'Pociones', crumbHref: '/es/potions/',
  quick: 'Respuesta rápida:',
  effectH: 'Efecto', recipeH: 'Receta', step: 'Paso', ings: 'Ingredientes', baseL: 'Base', effectL: 'Efecto', durationL: 'Duración',
  variantsH: 'Variantes', usesH: 'Mejores usos', editionH: 'Notas por edición', addedIn: 'Añadida en',
  relatedH: 'Pociones relacionadas', relHref: (r: string) => `/es/potions/${r}/`,
  title: `${p.name} - receta, efecto y usos`,
  desc: `${p.name} en Minecraft: ${effect}. Receta, duración, variantes y mejores usos.`,
  canonical: `/es/potions/${p.slug}/`, alt: `/potions/${p.slug}/`,
  headline: `${p.name}: receta de alquimia y usos en Minecraft`
} : {
  home: 'Home', homeHref: '/', crumb: 'Potions', crumbHref: '/potions/',
  quick: 'Quick answer:',
  effectH: 'Effect', recipeH: 'Recipe', step: 'Step', ings: 'Ingredients', baseL: 'Base', effectL: 'Effect', durationL: 'Duration',
  variantsH: 'Variants', usesH: 'Best uses', editionH: 'Edition notes', addedIn: 'Added in',
  relatedH: 'Related potions', relHref: (r: string) => `/potions/${r}/`,
  title: p.name,
  desc: `${p.name} in Minecraft: ${effect}. Recipe, duration, variants and best uses.`,
  canonical: `/potions/${p.slug}/`, alt: `/es/potions/${p.slug}/`,
  headline: `${p.name}: Minecraft brewing recipe and uses`
};

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: L.headline,
    description: effect,
    mainEntityOfPage: `https://minepedia.app${L.canonical}`,
    author: { '@type': 'Organization', name: 'Minepedia' }
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: L.home, item: `https://minepedia.app${L.homeHref}` },
      { '@type': 'ListItem', position: 2, name: L.crumb, item: `https://minepedia.app${L.crumbHref}` },
      { '@type': 'ListItem', position: 3, name: p.name, item: `https://minepedia.app${L.canonical}` }
    ]
  }
];
---
<Base title={L.title} description={L.desc} canonicalPath={L.canonical} jsonLd={jsonLd} ogType="article" lang={lang} altPath={L.alt}>
  <div class="container">
    <nav class="crumbs"><a href={L.homeHref}>{L.home}</a> / <a href={L.crumbHref}>{L.crumb}</a> / {p.name}</nav>
    <h1 style="display:flex;align-items:center;gap:12px"><PotionIcon color={COLORS[p.slug] || '#4caf50'} size={38} />{p.name}</h1>
    <div class="quick-answer"><strong>{L.quick}</strong> {recipe}. {effect}.</div>
    <h2>{L.effectH}</h2>
    <p>{effect}.</p>
    <h2>{L.recipeH}</h2>
    <BrewDiagram ingredient={ingredient} resultName={p.name} color={COLORS[p.slug] || '#4caf50'} base={base} lang={lang} />
    <table class="data">
      <tr><th>{L.step}</th><th>{L.ings}</th></tr>
      <tr><td>{L.baseL}</td><td>{baseText}</td></tr>
      <tr><td>{L.effectL}</td><td>{recipe}</td></tr>
      <tr><td>{L.durationL}</td><td>{duration}</td></tr>
    </table>
    <h2>{L.variantsH}</h2>
    <p>{variants}</p>
    <h2>{L.usesH}</h2>
    <ul>{uses.map((u: string) => <li>{u}</li>)}</ul>
    <h2>{L.editionH}</h2>
    <p>{editionNote} <em>{L.addedIn} {p.since}.</em></p>
    <h2>{L.relatedH}</h2>
    <p>{p.related.map((r: string) => <a href={L.relHref(r)} style="margin-right:12px">{relName(r)}</a>)}</p>
  </div>
</Base>
