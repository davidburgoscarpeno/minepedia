---
import Base from '../../layouts/Base.astro';
import items from '../../data/items.json';
import itemsEs from '../../data/items-es.json';

interface Props { i: any; lang: 'en' | 'es'; }
const { i, lang } = Astro.props;
const isES = lang === 'es';
const ov: any = isES ? (itemsEs as any)[i.slug] : null;
const howToGet = ov?.howToGet ?? i.howToGet;
const uses = ov?.uses ?? i.uses;
const renewable = ov?.renewable ?? i.renewable;
const editionNote = ov?.editionNote ?? i.editionNote;
const CAT_ES: Record<string, string> = { Material: 'Material', Utility: 'Utilidad', Block: 'Bloque', Combat: 'Combate', Weapon: 'Arma' };
const category = isES ? (CAT_ES[i.category] || i.category) : i.category;

const L = isES ? {
  home: 'Inicio', homeHref: '/es/', crumb: 'Objetos', crumbHref: '/es/items/',
  stackL: 'Apila:', sinceL: 'Desde', quick: 'Respuesta rápida:',
  getH: 'Cómo conseguirlo', usesH: 'Usos', renewH: 'Renovabilidad', editionsH: 'Java vs Bedrock',
  relatedL: 'Relacionados:', back: '\u2190 Todos los objetos', itemHref: (slug: string) => `/es/items/${slug}/`,
  title: `Cómo conseguir ${i.name}`,
  desc: `${i.name} en Minecraft: cómo conseguirlo, para qué sirve, renovabilidad y diferencias Java/Bedrock.`,
  canonical: `/es/items/${i.slug}/`, alt: `/items/${i.slug}/`,
  headline: `Cómo conseguir ${i.name} en Minecraft`,
  faq1: `\u00bfC\u00f3mo se consigue ${i.name} en Minecraft?`,
  faq2: `\u00bfPara qu\u00e9 sirve ${i.name}?`
} : {
  home: 'Home', homeHref: '/', crumb: 'Items', crumbHref: '/items/',
  stackL: 'Stack:', sinceL: 'Since', quick: 'Quick answer:',
  getH: 'How to get it', usesH: 'Uses', renewH: 'Renewability', editionsH: 'Java vs Bedrock',
  relatedL: 'Related:', back: '\u2190 All items', itemHref: (slug: string) => `/items/${slug}/`,
  title: `How to get ${i.name}`,
  desc: `Minecraft ${i.name}: how to get it, what it is used for, renewability and Java/Bedrock differences.`,
  canonical: `/items/${i.slug}/`, alt: `/es/items/${i.slug}/`,
  headline: `How to get ${i.name} in Minecraft`,
  faq1: `How do you get ${i.name} in Minecraft?`,
  faq2: `What is ${i.name} used for?`
};

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: L.headline,
    description: `${i.name} in Minecraft: ${i.howToGet[0]}. Uses, renewability and Java/Bedrock differences.`,
    mainEntityOfPage: `https://minepedia.app${L.canonical}`,
    author: { '@type': 'Organization', name: 'Minepedia' }
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: L.home, item: `https://minepedia.app${L.homeHref}` },
      { '@type': 'ListItem', position: 2, name: L.crumb, item: `https://minepedia.app${L.crumbHref}` },
      { '@type': 'ListItem', position: 3, name: i.name, item: `https://minepedia.app${L.canonical}` }
    ]
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: L.faq1,
        acceptedAnswer: { '@type': 'Answer', text: howToGet.join(' ') } },
      { '@type': 'Question', name: L.faq2,
        acceptedAnswer: { '@type': 'Answer', text: uses.join(' ') } }
    ]
  }
];
---
<Base title={L.title} description={L.desc} canonicalPath={L.canonical} jsonLd={jsonLd} ogType="article" lang={lang} altPath={L.alt}>
  <div class="container">
    <nav class="crumbs"><a href={L.homeHref}>{L.home}</a> / <a href={L.crumbHref}>{L.crumb}</a> / {i.name}</nav>
    <h1>{i.name}</h1>
    <p><span class="badge">{category}</span> <span class="badge">{L.stackL} {i.stackSize}</span> <span class="badge">{L.sinceL} {i.since}</span></p>
    <div class="quick-answer"><strong>{L.quick}</strong> {howToGet[0]}.</div>
    <h2>{L.getH}</h2>
    <ul>{howToGet.map((h: string) => <li>{h}</li>)}</ul>
    <h2>{L.usesH}</h2>
    <ul>{uses.map((u: string) => <li>{u}</li>)}</ul>
    <h2>{L.renewH}</h2>
    <p>{renewable}</p>
    <h2>{L.editionsH}</h2>
    <p>{editionNote}</p>
    {i.related.length > 0 && (
      <p><strong>{L.relatedL}</strong> {i.related.map((rel: string) => {
        const target = items.find((x: any) => x.slug === rel);
        return target ? <a href={L.itemHref(rel)} style="margin-right:12px">{target.name}</a> : null;
      })}</p>
    )}
    <p><a href={L.crumbHref}>{L.back}</a></p>
  </div>
</Base>
