---
interface Props { slug: string; name: string }
const { slug, name } = Astro.props;
---
<figure class="gameshot" style="margin:20px 0">
  <img src={`/biome-art/${slug}.png`} alt={`Pixel-art illustration of the Minecraft ${name} biome`} width="256" height="144" loading="lazy" style="width:100%;height:auto;border-radius:12px;display:block;image-rendering:pixelated" />
  <figcaption style="font-size:12px;opacity:.65;margin-top:6px">Original pixel-art illustration by Minepedia (fan art - not official Minecraft art. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT).</figcaption>
</figure>
